# Backend (FastAPI). Copy to .env. Names map to app/core/config.py (case-insensitive).
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Local without Docker: SQLite works. Staging/production MUST be PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://jlici:jlici@localhost:5432/jlici
DATABASE_URL=sqlite+aiosqlite:///./jlici-dev.db
REDIS_URL=redis://localhost:6379

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
FIELD_ENCRYPTION_KEY=change-me
REVALIDATE_SECRET=change-me
COOKIE_SECURE=false
COOKIE_DOMAIN=

# First super admin created by `python -m app.seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

